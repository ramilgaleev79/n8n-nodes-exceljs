{
	"name": "n8n-nodes-exceljs",
	"version": "0.3.1",
	"description": "n8n community node for reading, creating and manipulating Excel (.xlsx) files, powered by ExcelJS",
	"keywords": [
		"n8n-community-node-package",
		"n8n",
		"excel",
		"xlsx",
		"spreadsheet",
		"exceljs"
	],
	"license": "MIT",
	"homepage": "https://github.com/ramilgaleev79/n8n-nodes-exceljs#readme",
	"author": {
		"name": "Ramil Galeev",
		"url": "https://github.com/ramilgaleev79"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/ramilgaleev79/n8n-nodes-exceljs.git"
	},
	"main": "dist/nodes/ExcelJs/ExcelJs.node.js",
	"scripts": {
		"typecheck": "tsc --noEmit",
		"build": "npm run typecheck && node scripts/build.js",
		"prepublishOnly": "npm run build"
	},
	"files": [
		"dist"
	],
	"n8n": {
		"n8nNodesApiVersion": 1,
		"credentials": [],
		"nodes": [
			"dist/nodes/ExcelJs/ExcelJs.node.js"
		]
	},
	"devDependencies": {
		"@types/node": "^22.0.0",
		"esbuild": "^0.25.0",
		"exceljs": "^4.4.0",
		"n8n-workflow": "^1.44.0",
		"typescript": "~5.6.0"
	},
	"peerDependencies": {
		"n8n-workflow": "*"
	}
}
